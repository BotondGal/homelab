[Unit]
Description=llm docker compose stack
Requires=docker.service tailscaled.service
After=docker.service tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/homelab/machnies/the-node
Environment="GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=10"
ExecStartPre=-/usr/bin/git pull --ff-only
ExecStart=/srv/homelab/machnies/the-node/start.sh
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
